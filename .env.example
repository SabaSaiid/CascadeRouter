# ==============================================================================
# CascadeRouter IDE - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend service:
#   cp .env.example .env
#
# DO NOT commit .env or real API keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Nebius Token Factory & NVIDIA Nemotron Models
# ------------------------------------------------------------------------------
# Nebius Token Factory OpenAI-compatible API key
NEBIUS_API_KEY="your-nebius-token-factory-api-key-here"

# Nebius OpenAI-compatible API Base URL
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"

# Verified NVIDIA Nemotron Model Tiers on Nebius (Oct 2026 rates)
MODEL_TIER_EFFICIENT="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
MODEL_TIER_EFFICIENT_ALT="nvidia/Nemotron-3_5-Lightning"
MODEL_TIER_BALANCED="nvidia/Nemotron-3.5-Super-VL"
MODEL_TIER_POWERFUL="nvidia/Nemotron-3-Ultra-550b-a55b"

# Verified Pricing ($ per 1 Million Tokens)
PRICE_EFFICIENT_INPUT=0.06
PRICE_EFFICIENT_OUTPUT=0.24
PRICE_BALANCED_INPUT=0.30
PRICE_BALANCED_OUTPUT=0.90
PRICE_POWERFUL_INPUT=1.00
PRICE_POWERFUL_OUTPUT=3.00

# ------------------------------------------------------------------------------
# Compiler & Router Optimization Settings
# ------------------------------------------------------------------------------
# Default quality pass threshold (0.0 to 1.0)
QUALITY_THRESHOLD=0.92

# Maximum concurrency when benchmarking against Nebius Token Factory
BENCHMARK_CONCURRENCY=4

# Timeout per model benchmark call in seconds
BENCHMARK_TIMEOUT_SECONDS=45

# Regression test timeout in seconds
REGRESSION_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Allowed CORS origins for Vite frontend development server
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# Data Source & Mock / Demo Flags
# ------------------------------------------------------------------------------
# Options: "live" (real Nebius API calls), "recorded" (replays verified runs), "mock" (offline test fixture)
# "mock" is a frontend-only mode; the backend never fabricates data and treats it as "recorded".
DATA_SOURCE_MODE="live"

# Save every live Nebius response so it can be replayed in "recorded" mode
RECORD_RUNS=false
RECORDINGS_DIR="recordings"

# Directories /api/scan may read (comma-separated, relative to the repo root)
ALLOWED_SCAN_ROOTS="."

# Hosted Demo Rate Limiting & Safety (for judging period)
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
DAILY_SPEND_CAP_USD=10.00

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------
# Optional Tavily API Key for search-grounded agent workflows
TAVILY_API_KEY=""
